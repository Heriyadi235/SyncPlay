<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="复制"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="分享"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRawToggle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="JSON:关"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="清空"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnPauseScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂停刷新"
            android:textSize="12sp" />

        <!-- 清空歌词缓存：歌词匹配错了 / 负缓存锁死时用来强制重查。
             （原来的「始终解析导航包」已删除：现在非 FULL 时，只在信息页可见时解析） -->
        <Button
            android:id="@+id/btnClearLyricCache"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="清空歌词缓存"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 日志区 -->
    <ScrollView
        android:id="@+id/logScroll2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="6dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="等待…" />
    </ScrollView>

    <!-- ===== 车机屏幕预览 ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EEEEEE"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/previewInclude"
                layout="@layout/view_screen_preview" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
