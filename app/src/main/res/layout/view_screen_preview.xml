<?xml version="1.0" encoding="utf-8"?>
<!--
  车机屏幕预览 —— 两屏并列。

  每块屏固定 240dp 宽（模拟 4 寸屏的大致比例），居中显示，
  不铺满整个屏幕宽度。

  每行按 7 个汉字截断，超出显示 "..."。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvPreviewMode"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:paddingBottom="4dp"
        android:text="模式：—" />

    <!-- ===== 屏幕 1 ===== -->
    <FrameLayout
        android:id="@+id/canvas1"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:background="#1B3A5C"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#4DD0E1"
                    android:fontFamily="sans-serif-medium"
                    android:text="SyncPlay" />

                <TextView
                    android:id="@+id/tvClock1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:text="20:00" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="3dp"
                android:background="#3D6A96" />

            <!-- 内容：左侧滚动条 + 三行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8sp"
                        android:textColor="#7FB3D5"
                        android:text="▲" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="#4DD0E1"
                        android:text="SYNC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8sp"
                        android:textColor="#7FB3D5"
                        android:text="▼" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvS1L1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/tvS1L2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:text="" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="1dp">

                        <TextView
                            android:id="@+id/tvS1L3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#4DD0E1"
                            android:maxLines="1"
                            android:text="" />

                        <TextView
                            android:id="@+id/tvS1Timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#4DD0E1"
                            android:fontFamily="monospace"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 软键区
                 真实规则：
                   · 车机底栏是 4 个格子
                   · 我们用 Show.softButtons 只能占前几个（本车 softButtonCapabilities 只有 1 项）
                   · 第 4 格「更多」是车机自己加的，点进去就是 AddCommand/AddSubMenu 建的菜单页
                   · 我们的软键没用满时，空出来的格子显示为「—」（不可点）
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tvS1A"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <TextView
                    android:id="@+id/tvS1B"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <TextView
                    android:id="@+id/tvS1C"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <!-- 第 4 格固定是「更多」，车机自带 -->
                <TextView
                    android:id="@+id/tvS1D"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="更多…" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ===== 屏幕 2 ===== -->
    <FrameLayout
        android:id="@+id/canvas2"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1B3A5C"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#4DD0E1"
                    android:fontFamily="sans-serif-medium"
                    android:text="SyncPlay" />

                <TextView
                    android:id="@+id/tvClock2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:text="20:00" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="3dp"
                android:background="#3D6A96" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8sp"
                        android:textColor="#7FB3D5"
                        android:text="▲" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="#4DD0E1"
                        android:text="SYNC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="8sp"
                        android:textColor="#7FB3D5"
                        android:text="▼" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvS2L1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/tvS2L2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:text="" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="1dp">

                        <TextView
                            android:id="@+id/tvS2L3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#4DD0E1"
                            android:maxLines="1"
                            android:text="" />

                        <TextView
                            android:id="@+id/tvS2Timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#4DD0E1"
                            android:fontFamily="monospace"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tvS2A"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <TextView
                    android:id="@+id/tvS2B"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <TextView
                    android:id="@+id/tvS2C"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="" />

                <!-- 第 4 格固定是「更多」，车机自带 -->
                <TextView
                    android:id="@+id/tvS2D"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:text="更多…" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
