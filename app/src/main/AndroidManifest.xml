<?xml version="1.0" encoding="utf-8"?>
<!--
  SyncGlance —— SYNC 1.1 车载助手
  歌曲信息 · 导航信息 · 计时器

  关键约束：
  - targetSdk 35（Android 15）：SDL 5.8.0 起可用；4.12.2 时代必须锁 32（见 legacy/sdl4 分支）
  - 主题必须是 Theme.AppCompat.*
  - 传输层用 MultiplexTransportConfig（车机才能发现）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 蓝牙（Android 12+ 权限拆分）
         ★ 5.x 的 IntegrationValidator 会用当前 SDK 实际授予的权限去校验，
           带 maxSdkVersion="30" 会在 Android 13+ 上被判成"缺少 BLUETOOTH"，
           进而让 queryForConnectedService / SdlBroadcastReceiver 的检查直接失败。
           所以这里不给 maxSdkVersion（4.x 时没这个检查，5.x 必须去掉）。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- 开机自启 / 蓝牙事件拉起 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 联网查歌词（lrclib.net） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ★ targetSdk 33+：前台服务的常驻通知必须靠它。不声明/不申请的话通知栏不显示，
         前台服务的可见性和保活能力都会打折。运行时在 MainActivity 里申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ★ 高德导航服务权限（dumpsys 显示 prot=normal，声明即可） -->
    <uses-permission android:name="com.autonavi.minimap.permission.NAVIGATION_SERVICE" />

    <!-- Android 11+ 需要声明才能 bind 或查询其他应用 -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <intent>
            <action android:name="com.autonavi.minimap.service.NAVIGATION_SERVICE" />
        </intent>
        <!-- ★ SDL 5.x 必须：否则看不到 / 查不到自己的 RouterService，
             表现为 SdlManager 建好就立刻自毁、SyncRouterService 根本不起进程 -->
        <intent>
            <action android:name="com.smartdevicelink.router.service" />
        </intent>
        <intent>
            <action android:name="sdl.router.startservice" />
        </intent>
    </queries>

    <application
        android:name=".SyncGlanceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncGlance">
        <!-- 主题见 res/values/themes.xml：
             自带 windowOptOutEdgeToEdgeEnforcement（targetSdk 35 的 edge-to-edge 开关）。
             ★ 这个属性只能写在 style 里，写在本标签上不生效。 -->

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.LogActivity"
            android:exported="true"
            android:label="信息"
            android:parentActivityName=".activity.MainActivity" />
        <!-- SDL 通信服务（前台服务，常驻） -->
        <service
            android:name=".service.SdlService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- ===== SDL 传输层 =====
             这两个是 SDL 官方标准集成，缺一不可：

             1. SyncRouterService —— 常驻的蓝牙路由器。负责监听 RFCOMM、
                注册 SDP 记录（车机靠它发现本应用），并把一条物理连接
                多路复用给多个 SDL 应用。action 必须是库定义的那个字符串。
             2. SdlReceiver —— 官方生命周期入口。监听 ACL_CONNECTED 与
                sdl.router.startservice，负责把整个链路串起来。

             之前只用了自写的 BootReceiver，没有声明 router service，
             于是「应用没启动时车机连不上、之后也再连不上」——
             因为没有任何东西在车机连接窗口期里监听 RFCOMM。 -->
        <service
            android:name=".receiver.SyncRouterService"
            android:exported="true"
            android:process="com.smartdevicelink.router"
            android:foregroundServiceType="connectedDevice">
            <intent-filter>
                <action android:name="com.smartdevicelink.router.service" />
            </intent-filter>
            <!-- ★ 5.x 官方集成要求：缺这两行 meta-data，RouterService 起来也会被判非法，
                 进而让 SdlManager 一建好就自毁（无车机时表现为立刻"连接结束"）。
                 资源由 SDL 库提供，不要改成裸字符串。 -->
            <meta-data
                android:name="@string/sdl_router_service_version_name"
                android:value="@integer/sdl_router_service_version_value" />
        </service>

        <receiver
            android:name=".receiver.SdlReceiver"
            android:exported="true">
            <!-- ★ 5.x 的 IntegrationValidator 会拿 sdl.router.startservice 去
                 queryBroadcastReceivers 找本应用的 SDL receiver，找不到就判失败，
                 进而让 queryForConnectedService 抛异常。
                 这条 action 也是「RouterService 反过来唤醒应用进程」的通道，
                 4.x 时我们漏了它，等于那条唤醒链路一直是死的。 -->
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="sdl.router.startservice" />
            </intent-filter>
            <!-- ★ PACKAGE_* 必须单独一组：<data> 会把同组所有 action 都要求带 package: 的 data，
                 混在一起会让 ACL_CONNECTED 永远匹配不到。 -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 蓝牙/开机事件拉起服务 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 装包/升级后立即重连（对应 BootReceiver 里的分支） -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ★ 通知监听：读音乐/导航 app 的通知 -->
        <service
            android:name=".service.NotificationCatcher"
            android:exported="false"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
